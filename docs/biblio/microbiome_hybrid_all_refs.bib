@article{j2018phylogenetic,
  title = {Phylogenetic Placement of Exact Amplicon Sequences Improves Associations with Clinical Information},
  author = {J and a and n and s and s and e and n and , and and S and t and e and f and a and n and and a and n and d and and M and c and D and o and n and a and l and d and , and and D and a and n and i and e and l and and a and n and d and and G and o and n and z and á and l and e and z and , and and A and n and t and o and n and i and o and and a and n and d and and N and a and v and a and s and - and M and o and l and i and n and a and , and and J and o and s and é and and A and . and and a and n and d and and J and i and a and n and g and , and and L and i and n and g and j and i and n and g and and a and n and d and and X and u and , and and Z and h and e and n and j and i and a and n and g and and Z and e and c and h and and a and n and d and and W and i and n and k and e and r and , and and K and e and v and i and n and and a and n and d and and K and a and d and o and , and and D and e and b and o and r and a and h and and M and . and and a and n and d and and O and r and w and o and l and l and , and and E and r and i and c and and a and n and d and and M and a and n and a and r and y and , and and M and a and r and k and and a and n and d and and M and i and r and a and r and a and b and , and and S and i and a and v and a and s and h and and a and n and d and and K and n and i and g and h and t and , and and R and o and b},
  year = {2018},
  journal = {mSystems},
  doi = {10.1128/msystems.00021-18},
  url = {https://doi.org/10.1128/msystems.00021-18},
  abstract = {The move from OTU-based to sOTU-based analysis, while providing additional resolution, also introduces computational challenges. We demonstrate that one popular method of dealing with sOTUs (building a de novo tree from the short sequences) can provide incorrect results in human gut metagenomic studies and show that phylogenetic placement of the new sequences with SEPP resolves this problem while also yielding other benefits over existing methods. ABSTRACT Recent algorithmic advances in amplicon-based microbiome studies enable the inference of exact amplicon sequence fragments. These new methods enable the investigation of sub-operational taxonomic units (sOTU) by removing erroneous sequences. However, short (e.g., 150-nucleotide [nt]) DNA sequence fragments do not contain sufficient phylogenetic signal to reproduce a reasonable tree, introducing a barrier in the utilization of critical phylogenetically aware metrics such as Faith’s PD or UniFrac. Although fragment insertion methods do exist, those methods have not been tested for sOTUs from high-throughput amplicon studies in insertions against a broad reference phylogeny. We benchmarked the SATé-enabled phylogenetic placement (SEPP) technique explicitly against 16S V4 sequence fragments and showed that it outperforms the conceptually problematic but often-used practice of reconstructing de novo phylogenies. In addition, we provide a BSD-licensed QIIME2 plugin (https://github.com/biocore/q2-fragment-insertion) for SEPP and integration into the microbial study management platform QIITA. IMPORTANCE The move from OTU-based to sOTU-based analysis, while providing additional resolution, also introduces computational challenges. We demonstrate that one popular method of dealing with sOTUs (building a de novo tree from the short sequences) can provide incorrect results in human gut metagenomic studies and show that phylogenetic placement of the new sequences with SEPP resolves this problem while also yielding other benefits over existing methods.},
  note = {cited-by: 450; sources: sota\_16S},
  keywords = {methodes-16S, tissus}
}

@article{j2013diversity,
  title = {Diversity and heritability of the maize rhizosphere microbiome under field conditions},
  author = {J and a and s and o and n and and A and . and and P and e and i and f and f and e and r and and a and n and d and and A and y and m and é and and S and p and o and r and and a and n and d and and O and m and r and y and and K and o and r and e and n and and a and n and d and and Z and h and a and o and and J and i and n and and a and n and d and and S and u and s and a and n and n and a and h and and G and . and and T and r and i and n and g and e and and a and n and d and and J and e and f and f and e and r and y and and L and . and and D and a and n and g and l and and a and n and d and and E and d and w and a and r and d and and S and . and and B and u and c and k and l and e and r and and a and n and d and and R and u and t and h and and E and . and and L and e and y},
  year = {2013},
  journal = {Proceedings of the National Academy of Sciences},
  doi = {10.1073/pnas.1302837110},
  url = {https://doi.org/10.1073/pnas.1302837110},
  abstract = {The rhizosphere is a critical interface supporting the exchange of resources between plants and their associated soil environment. Rhizosphere microbial diversity is influenced by the physical and chemical properties of the rhizosphere, some of which are determined by the genetics of the host plant. However, within a plant species, the impact of genetic variation on the composition of the microbiota is poorly understood. Here, we characterized the rhizosphere bacterial diversity of 27 modern maize inbreds possessing exceptional genetic diversity grown under field conditions. Randomized and replicated plots of the inbreds were planted in five field environments in three states, each with unique soils and management conditions. Using pyrosequencing of bacterial 16S rRNA genes, we observed substantial variation in bacterial richness, diversity, and relative abundances of taxa between bulk soil and the maize rhizosphere, as well as between fields. The rhizospheres from maize inbreds exhibited both a small but significant proportion of heritable variation in total bacterial diversity across fields, and substantially more heritable variation between replicates of the inbreds within each field. The results of this study should facilitate expanded studies to identify robust heritable plant-microbe interactions at the level of individual polymorphisms by genome wide association, so that plant-microbiome interactions can ultimately be incorporated into plant breeding.},
  note = {sources: hybrides},
  keywords = {heritabilite}
}

