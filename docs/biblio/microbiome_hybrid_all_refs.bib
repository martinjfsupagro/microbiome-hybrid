@article{l2022consistent,
  title = {Consistent changes in the intestinal microbiota of Atlantic salmon fed insect meal diets},
  author = {L and i and , and and Y and a and n and x and i and a and n and and a and n and d and and G and a and j and a and r and d and o and , and and K and a and r and i and n and a and and a and n and d and and J and a and r and a and m and i and l and l and o and - and T and o and r and r and e and s and , and and A and l and e and x and a and n and d and e and r and and a and n and d and and K and o and r and t and n and e and r and , and and T and r and o and n and d and and M and . and and a and n and d and and K and r and o and g and d and a and h and l and , and and Å and s and h and i and l and d},
  year = {2022},
  journal = {Animal Microbiome},
  doi = {10.1186/s42523-021-00159-4},
  url = {https://doi.org/10.1186/s42523-021-00159-4},
  abstract = {BACKGROUND: Being part of fish's natural diets, insects have become a practical alternative feed ingredient for aquaculture. While nutritional values of insects have been extensively studied in various fish species, their impact on the fish microbiota remains to be fully explored. In an 8-week freshwater feeding trial, Atlantic salmon (Salmo salar) were fed either a commercially relevant reference diet or an insect meal diet wherein black soldier fly (Hermetia illucens) larvae meal comprised 60\textbackslash{}\% of total ingredients. Microbiota of digesta and mucosa origin from the proximal and distal intestine were collected and profiled along with feed and water samples. RESULTS: The insect meal diet markedly modulated the salmon intestinal microbiota. Salmon fed the insect meal diet showed similar or lower alpha-diversity indices in the digesta but higher alpha-diversity indices in the mucosa. A group of bacterial genera, dominated by members of the Bacillaceae family, was enriched in salmon fed the insect meal diet, which confirms our previous findings in a seawater feeding trial. We also found that microbiota in the intestine closely resembled that of the feeds but was distinct from the water microbiota. Notably, bacterial genera associated with the diet effects were also present in the feeds. CONCLUSIONS: We conclude that salmon fed the insect meal diets show consistent changes in the intestinal microbiota. The next challenge is to evaluate the extent to which these alterations are attributable to feed microbiota and dietary nutrients, and what these changes mean for fish physiology and health.},
  note = {sources: fish\_key},
  keywords = {poisson, tissus}
}

