# config/project.env — variables du projet microbiome-hybrid
# À sourcer en début de chaque job SLURM :
#   source "$WORK/projects/microbiome-hybrid/config/project.env"

# $WORK / $SCRATCH viennent du .bashrc et sont hérités par SLURM (--export=ALL).
# Repli explicite pour les shells non interactifs (cron, `bash -c`, conteneur),
# où .bashrc n'est pas lu : sans ça, `set -u` fait échouer le job ici.
export WORK="${WORK:-$HOME/work}"
export SCRATCH="${SCRATCH:-$HOME/scratch_biomics}"

export PROJECT="microbiome-hybrid"
export PROJECT_DIR="$WORK/projects/$PROJECT"
export SCRATCH_DIR="$SCRATCH/runs/$PROJECT"

# Note : SLURM n'expanse PAS les variables dans les directives #SBATCH.
# L'adresse est donc écrite en dur dans les scripts de job ; cette variable
# ne sert qu'aux notifications envoyées depuis le corps d'un script.
export SLURM_MAIL="jean-francois.martin@supagro.fr"

# ── Données ──────────────────────────────────────────────────────────────────
# Source unique consolidée : un sous-dossier de fastq.gz R1/R2 par run.
# 16S V4 (assay Schloss/Caporaso), amorces DÉJÀ retirées des lectures.
export RAW_DIR="$PROJECT_DIR/consolidated_dataset"
export RUNS="durance1 durance2 durance3"

# ── Conteneurs Singularity (work/shared_softwares) ───────────────────────────
export SIF_DIR="$WORK/shared_softwares"
export SIF_FASTQC="$SIF_DIR/fastqc/fastqc_latest"              # FastQC
export SIF_MULTIQC="$SIF_DIR/multiqc/multiqc_latest"           # MultiQC
export SIF_CUTADAPT="$SIF_DIR/cutadapt/cutadapt5.0_latest.sif" # cutadapt 5.0

# ── Environnement R / DADA2 ──────────────────────────────────────────────────
export R_ENV="$HOME/bin/envs/dada2"                            # bioconductor-dada2

# ── Référence taxonomique SILVA v138.2 (format DADA2, Zenodo 14169026) ────────
export SILVA_TRAIN="${SILVA_TRAIN:-$SIF_DIR/silva/silva_nr99_v138.2_toGenus_trainset.fa.gz}"
export SILVA_SPECIES="${SILVA_SPECIES:-$SIF_DIR/silva/silva_v138.2_assignSpecies.fa.gz}"

# ── Paramètres 16S V4 ────────────────────────────────────────────────────────
# Amorces Caporaso 2011 (établi sur le projet Apron, même assay). Elles ne sont
# PAS dans les lectures (protocole Schloss : amorces = amorces de séquençage),
# donc pas de retrait 5'. Servent au retrait du 12S co-amplifié (voir 02).
export PRIMER_515F="GTGCCAGCMGCCGCGGTAA"
export PRIMER_806R="GGACTACHVGGGTWTCTAAT"
# truncLen DADA2 (R1,R2) : profils qualité quasi identiques sur les 3 runs ;
# insert V4 ~253 pb, reads 2×251 → recouvrement ~167 pb, large.
export TRUNC_F=230
export TRUNC_R=190
